{
  "name": "@vmasrani/fuzzy-img-viewer",
  "version": "0.1.1",
  "description": "High-performance image browser with fuzzy search and virtualized grid rendering",
  "author": "vmasrani",
  "license": "MIT",
  "type": "module",
  "bin": {
    "fuzzy-img-viewer": "./bin/cli.js"
  },
  "files": [
    "dist",
    "bin",
    "backend/target/release/fuzzy-img-viewer-backend*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "tsc && vite build",
    "build:backend": "cd backend && cargo build --release",
    "preview": "vite preview",
    "package": "npm run build && npm pack",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.10.8",
    "fuzzysort": "3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "image-viewer",
    "image-browser",
    "fuzzy-search",
    "thumbnail-viewer",
    "rust",
    "react"
  ]
}
